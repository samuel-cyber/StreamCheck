# --- AI provider ---
# Get a free key at https://aistudio.google.com/apikey
# While GEMINI_API_KEY is unset, the app runs in MOCK_AI mode with deterministic fake AI output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- FHIR server ---
# Public HAPI test server by default; no Docker needed for the demo.
# For a local server: docker compose up -d  (then use http://localhost:8080/fhir)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# --- App ---
# Used for building photo URLs shown in the dashboard
PUBLIC_BASE_URL=http://localhost:8000
