# Riparia environment template — copy to .env for local dev.
# In production (Render) these are set in the dashboard, never in files.

# --- Environment ---
ENVIRONMENT=development

# --- Database ---
# Local dev default is SQLite (data/riparia.db). Production uses Postgres:
# DATABASE_URL=postgresql://user:pass@host:5432/riparia

# --- App ---
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000

# --- AI (free key: https://aistudio.google.com/apikey) ---
# Left empty, the AI pipeline runs in deterministic preview mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- FHIR server ---
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# --- Reviewer auth ---
REVIEWER_USERNAME=reviewer
# bcrypt hash — generate with:
#   py -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(12)).decode())"
# Dev default hash below = password "reviewer-dev-password"
REVIEWER_PASSWORD_HASH=$2b$12$VsOxqi1z4Ju2kXGiLrfFh.mOik7ZXH/fiSTSwODSDz.4EcNlFfIEq
# Long random string; required (non-default) in production.
SESSION_SECRET=

# --- Cloudflare R2 (optional in dev; photos fall back to data/) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Rate limits ---
RATE_LIMIT_SUBMIT=10/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=120/minute
